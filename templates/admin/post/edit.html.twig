{% extends 'admin/base.html.twig' %}

{% block title %}{{ is_new ? 'Nouvel article' : post.title }}{% endblock %}

{% block page_title %}
    <span class="flex items-center gap-2.5">
        {{ is_new ? 'Nouvel article' : post.title }}
        {% if not is_new %}
            <span class="px-2 py-0.5 text-[11px] font-bold {{ post.published ? 'border border-ink text-ink' : 'border border-accent text-accent' }}">
                {{ post.published ? 'Publié' : 'Brouillon' }}
            </span>
        {% endif %}
    </span>
{% endblock %}

{% block header_actions %}
    {% if not is_new %}
        <a href="{{ post_path(post) }}" target="_blank"
           class="inline-flex items-center gap-1.5 rounded-none border border-ink/30 px-3.5 py-2 text-[13px] font-bold text-ink/75 transition hover:bg-ink/5">
            {{ post.published ? 'Voir l\'article' : 'Prévisualiser' }}
        </a>
        <form method="post" action="{{ path('admin_post_publish', {id: post.id}) }}" class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
            <button type="submit" class="rounded-none {{ post.published ? 'border border-ink/30 text-ink/75 hover:bg-ink/5' : 'bg-ink text-paper hover:bg-accent' }} px-3.5 py-2 text-[13px] font-bold transition">
                {{ post.published ? 'Repasser en brouillon' : 'Publier' }}
            </button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="mx-auto max-w-3xl">
        {{ form_start(form) }}
            <div class="rounded-none border border-ink/15 bg-paper p-6">
                {{ form_row(form.title) }}
                {{ form_row(form.slug) }}
                {{ form_row(form.locale) }}
                {{ form_row(form.category) }}
                {{ form_row(form.coverImage) }}
                {{ form_row(form.coverAlt) }}
                {{ form_row(form.excerpt) }}
                {{ form_row(form.content) }}
            </div>

            <div class="mt-5 rounded-none border border-ink/15 bg-paper p-6">
                <h2 class="mb-5 text-sm font-bold">SEO</h2>
                {{ form_row(form.metaTitle) }}
                {{ form_row(form.metaDescription) }}
            </div>

            <div class="mt-5 flex items-center justify-end gap-3">
                <a href="{{ path('admin_posts') }}" class="rounded-none px-4 py-2.5 text-sm font-semibold text-ink/55 hover:text-ink/90">Retour</a>
                <button type="submit" class="rounded-none bg-ink px-5 py-2.5 text-sm font-bold text-paper transition hover:bg-accent">
                    Enregistrer
                </button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
