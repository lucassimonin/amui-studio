{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Actualités{% endblock %}
{% block page_title %}Actualités{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_post_new') }}" class="inline-flex items-center gap-1.5 rounded-none bg-ink px-3.5 py-2 text-[13px] font-bold text-paper transition hover:bg-accent">
        {{ icons.icon('plus', 'h-4 w-4') }} Nouvel article
    </a>
{% endblock %}

{% block content %}
    <div class="grid gap-8 xl:grid-cols-[1fr_300px]">

        {# ---- Articles ---- #}
        <div class="overflow-hidden rounded-none border border-ink/15 bg-paper">
            <table class="w-full text-left text-sm">
                <thead class="bg-ink/5 text-[11px] font-bold uppercase tracking-wider text-ink/45">
                    <tr>
                        <th class="px-5 py-3">Titre</th>
                        <th class="px-5 py-3">Catégorie</th>
                        <th class="px-5 py-3">Statut</th>
                        <th class="px-5 py-3">Modifié</th>
                        <th class="px-5 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink/10">
                    {% for post in posts %}
                        <tr class="transition hover:bg-ink/5/60">
                            <td class="px-5 py-3.5">
                                <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="font-semibold text-ink hover:text-accent">{{ post.title }}</a>
                            </td>
                            <td class="px-5 py-3.5 text-xs text-ink/55">{{ post.category ? post.category.name : '—' }}</td>
                            <td class="px-5 py-3.5">
                                <span class="px-2 py-0.5 text-[11px] font-bold {{ post.published ? 'border border-ink text-ink' : 'border border-accent text-accent' }}">
                                    {{ post.published ? 'Publié le ' ~ post.publishedAt|date('d/m/Y') : 'Brouillon' }}
                                </span>
                            </td>
                            <td class="px-5 py-3.5 text-xs text-ink/45">{{ post.updatedAt|date('d/m/Y H:i') }}</td>
                            <td class="px-5 py-3.5">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="{{ post_path(post) }}" target="_blank"
                                       class="rounded-none p-2 text-ink/45 transition hover:bg-ink/10 hover:text-ink/75" title="{{ post.published ? 'Voir' : 'Prévisualiser' }}">
                                        {{ icons.icon('external', 'h-4 w-4') }}
                                    </a>
                                    <form method="post" action="{{ path('admin_post_publish', {id: post.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                        <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:bg-ink/10 hover:text-ink/75" title="{{ post.published ? 'Repasser en brouillon' : 'Publier' }}">
                                            {{ icons.icon(post.published ? 'eye-off' : 'check', 'h-4 w-4') }}
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" data-confirm="Supprimer l'article « {{ post.title }} » ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                        <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:text-accent" title="Supprimer">
                                            {{ icons.icon('trash', 'h-4 w-4') }}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="px-5 py-10 text-center text-ink/45">Aucun article. Rédigez le premier !</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# ---- Catégories ---- #}
        <aside class="rounded-none border border-ink/15 bg-paper p-5">
            <h2 class="text-sm font-bold">Catégories</h2>
            <ul class="mt-4 space-y-2">
                {% for category in categories %}
                    <li class="flex items-center justify-between rounded-none bg-ink/5 px-3 py-2">
                        <span class="text-[13px] font-semibold text-ink/75">{{ category.name }}</span>
                        <form method="post" action="{{ path('admin_post_category_delete', {id: category.id}) }}" data-confirm="Supprimer la catégorie « {{ category.name }} » ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                            <button type="submit" class="rounded p-1 text-ink/30 transition hover:text-accent" title="Supprimer">
                                {{ icons.icon('trash', 'h-3.5 w-3.5') }}
                            </button>
                        </form>
                    </li>
                {% else %}
                    <li class="text-xs text-ink/45">Aucune catégorie.</li>
                {% endfor %}
            </ul>
            <form method="post" action="{{ path('admin_post_category_add') }}" class="mt-4 flex gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                <input type="text" name="name" required placeholder="Nouvelle catégorie"
                       class="block w-full rounded-none border border-ink/30 px-3 py-2 text-sm outline-none focus:border-accent">
                <button type="submit" class="shrink-0 rounded-none bg-ink px-3 text-xs font-bold text-paper transition hover:bg-ink/75">Ajouter</button>
            </form>
        </aside>
    </div>
{% endblock %}
