{% extends 'admin/base.html.twig' %}

{% block title %}Réglages{% endblock %}
{% block page_title %}Réglages du site{% endblock %}

{% block content %}
    <form method="post" class="mx-auto max-w-2xl">
        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
        <div class="rounded-none border border-ink/15 bg-paper p-6">
            {% for key, meta in fields %}
                <div class="mb-4">
                    {% if key == 'maintenance_mode' %}
                        <div class="flex items-start gap-2.5 rounded-none border border-accent bg-accent/60 p-3">
                            <input type="checkbox" id="setting-{{ key }}" name="{{ key }}" value="1" {{ values[key]|default('') == '1' ? 'checked' }}
                                   class="mt-0.5 h-4 w-4 rounded border-ink/30 accent-accent">
                            <div>
                                <label for="setting-{{ key }}" class="text-[13px] font-semibold text-ink/75">{{ meta[0] }}</label>
                                {% if meta[1] %}<p class="text-xs text-ink/45">{{ meta[1] }}</p>{% endif %}
                            </div>
                        </div>
                    {% else %}
                    <label for="setting-{{ key }}" class="mb-1.5 block text-[13px] font-semibold text-ink/75">{{ meta[0] }}</label>
                    <div {% if key in ['logo_url', 'favicon_url'] %}data-media-field class="flex gap-2"{% endif %}>
                        <input type="text" id="setting-{{ key }}" name="{{ key }}" value="{{ values[key]|default('') }}"
                               class="block w-full rounded-none border border-ink/30 px-3 py-2 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/15">
                        {% if key in ['logo_url', 'favicon_url'] %}
                            <button type="button" data-media-picker class="shrink-0 rounded-none border border-ink/30 px-3.5 py-2 text-xs font-bold text-ink/65 transition hover:border-accent hover:text-accent">Parcourir</button>
                        {% endif %}
                    </div>
                    {% if meta[1] %}<p class="mt-1 text-xs text-ink/45">{{ meta[1] }}</p>{% endif %}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        <button type="submit" class="mt-5 w-full rounded-none bg-ink px-4 py-3 text-sm font-bold text-paper transition hover:bg-accent">
            Enregistrer les réglages
        </button>
    </form>
{% endblock %}
