{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Messages{% endblock %}
{% block page_title %}
    Messages reçus
    {% if unread_count > 0 %}
        <span class="ml-2 bg-accent px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-paper">{{ unread_count }} non lu{{ unread_count > 1 ? 's' }}</span>
    {% endif %}
{% endblock %}

{% block content %}
    {% if messages is empty %}
        <div class="rounded-none border-2 border-dashed border-ink/30 bg-paper px-6 py-14 text-center">
            <p class="text-sm font-semibold text-ink/55">Aucun message</p>
            <p class="mt-1 text-sm text-ink/45">Les envois du formulaire de contact apparaîtront ici, en plus de l'email.</p>
        </div>
    {% else %}
        <div class="space-y-3">
            {% for message in messages %}
                <details class="group rounded-none border bg-paper {{ message.isRead ? 'border-ink/15' : 'border-accent/40 shadow-none' }}">
                    <summary class="flex cursor-pointer flex-wrap items-center gap-x-4 gap-y-1 px-5 py-4 [&::-webkit-details-marker]:hidden">
                        {% if not message.isRead %}
                            <span class="h-2 w-2 shrink-0 rounded-full bg-accent" title="Non lu"></span>
                        {% endif %}
                        <span class="text-sm {{ message.isRead ? 'font-semibold text-ink/65' : 'font-bold' }}">{{ message.name }}</span>
                        <span class="text-xs text-ink/45">{{ message.email }}</span>
                        {% if message.subject %}
                            <span class="rounded-full bg-ink/10 px-2 py-0.5 text-[11px] font-bold text-ink/65">{{ message.subject }}</span>
                        {% endif %}
                        {% if not message.isRead %}
                            <span class="bg-accent px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-paper">Non lu</span>
                        {% endif %}
                        <span class="ml-auto text-xs text-ink/45">{{ message.createdAt|date('d/m/Y H:i') }}</span>
                        {{ icons.icon('chevron', 'h-4 w-4 text-ink/30 transition group-open:rotate-180') }}
                    </summary>

                    <div class="border-t border-ink/10 px-5 py-4">
                        <p class="whitespace-pre-line text-sm leading-relaxed text-ink/75">{{ message.message }}</p>
                        <p class="mt-3 text-xs text-ink/45">Email envoyé à : {{ message.recipient }}</p>

                        <div class="mt-4 flex flex-wrap items-center gap-2">
                            <a href="mailto:{{ message.email }}?subject=Re:%20{{ (message.subject ?: 'votre message')|url_encode }}"
                               class="inline-flex items-center gap-1.5 rounded-none bg-ink px-3.5 py-2 text-xs font-bold text-paper transition hover:bg-ink/75">
                                Répondre par email
                            </a>
                            <form method="post" action="{{ path('admin_message_toggle', {id: message.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button type="submit" class="rounded-none border border-ink/15 px-3.5 py-2 text-xs font-bold text-ink/65 transition hover:border-accent hover:text-accent">
                                    Marquer {{ message.isRead ? 'non lu' : 'lu' }}
                                </button>
                            </form>
                            <form method="post" action="{{ path('admin_message_delete', {id: message.id}) }}" data-confirm="Supprimer définitivement ce message ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:text-accent" title="Supprimer">
                                    {{ icons.icon('trash', 'h-4 w-4') }}
                                </button>
                            </form>
                        </div>
                    </div>
                </details>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
