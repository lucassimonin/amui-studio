{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Pages{% endblock %}
{% block page_title %}Pages{% endblock %}

{% block header_actions %}
    <form method="post" action="{{ path('admin_page_import') }}" enctype="multipart/form-data" class="flex items-center gap-2">
        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
        <label class="cursor-pointer rounded-none border border-ink/30 px-3.5 py-2 text-[13px] font-bold text-ink/65 transition hover:border-accent hover:text-accent">
            Importer un JSON
            <input type="file" name="file" accept="application/json,.json" class="hidden" onchange="this.form.submit()">
        </label>
    </form>
    <a href="{{ path('admin_page_new') }}" class="inline-flex items-center gap-1.5 rounded-none bg-ink px-3.5 py-2 text-[13px] font-bold text-paper transition hover:bg-accent">
        {{ icons.icon('plus', 'h-4 w-4') }} Nouvelle page
    </a>
{% endblock %}

{% block content %}
    <div class="overflow-hidden rounded-none border border-ink/15 bg-paper">
        <table class="w-full text-left text-sm">
            <thead class="bg-ink/5 text-[11px] font-bold uppercase tracking-wider text-ink/45">
                <tr>
                    <th class="px-5 py-3">Titre</th>
                    <th class="px-5 py-3">URL</th>
                    <th class="px-5 py-3">Statut</th>
                    <th class="px-5 py-3">Blocs</th>
                    <th class="px-5 py-3">Modifiée</th>
                    <th class="px-5 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-ink/10">
                {% for page in pages %}
                    <tr class="transition hover:bg-ink/5/60">
                        <td class="px-5 py-3.5">
                            <a href="{{ path('admin_page_edit', {id: page.id}) }}" class="inline-flex items-center gap-2 font-semibold text-ink hover:text-accent">
                                {{ page.title }}
                                {% if page.isHomepage %}{{ icons.icon('home', 'h-3.5 w-3.5 text-ink/45') }}{% endif %}
                            </a>
                        </td>
                        <td class="px-5 py-3.5">
                            <span class="mr-1.5 rounded bg-ink/10 px-1.5 py-0.5 text-[10px] font-bold uppercase text-ink/55">{{ page.locale }}</span>
                            <span class="font-mono text-xs text-ink/55">{{ page_path(page) }}</span>
                        </td>
                        <td class="px-5 py-3.5">
                            <span class="px-2 py-0.5 text-[11px] font-bold {{ page.published ? 'border border-ink text-ink' : 'border border-accent text-accent' }}">
                                {{ page.published ? 'Publiée' : 'Brouillon' }}
                            </span>
                        </td>
                        <td class="px-5 py-3.5 text-ink/55">{{ page.blocks|length }}</td>
                        <td class="px-5 py-3.5 text-xs text-ink/45">{{ page.updatedAt|date('d/m/Y H:i') }}</td>
                        <td class="px-5 py-3.5">
                            <div class="flex items-center justify-end gap-1">
                                <a href="{{ page_path(page) }}{{ not page.published ? '?preview=' ~ page.previewToken }}" target="_blank"
                                   class="rounded-none p-2 text-ink/45 transition hover:bg-ink/10 hover:text-ink/75" title="{{ page.published ? 'Voir la page' : 'Prévisualiser' }}">
                                    {{ icons.icon('external', 'h-4 w-4') }}
                                </a>
                                <a href="{{ path('admin_page_export', {id: page.id}) }}"
                                   class="rounded-none p-2 text-ink/45 transition hover:bg-ink/10 hover:text-ink/75" title="Exporter en JSON (réutilisable dans un autre projet)">
                                    {{ icons.icon('redirects', 'h-4 w-4') }}
                                </a>
                                <form method="post" action="{{ path('admin_page_duplicate', {id: page.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                    <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:bg-ink/10 hover:text-ink/75" title="Dupliquer la page (blocs + SEO)">
                                        {{ icons.icon('copy', 'h-4 w-4') }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin_page_delete', {id: page.id}) }}" data-confirm="Supprimer la page « {{ page.title }} » et tous ses blocs ?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                    <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:text-accent" title="Supprimer">
                                        {{ icons.icon('trash', 'h-4 w-4') }}
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="px-5 py-10 text-center text-ink/45">Aucune page. Créez votre première page.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
