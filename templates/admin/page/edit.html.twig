{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}{{ page.title }}{% endblock %}

{% block page_title %}
    <span class="flex items-center gap-2.5">
        {{ page.title }}
        {% if page.isHomepage %}{{ icons.icon('home', 'h-4 w-4 text-ink/45') }}{% endif %}
        <span class="px-2 py-0.5 text-[11px] font-bold {{ page.published ? 'border border-ink text-ink' : 'border border-accent text-accent' }}">
            {{ page.published ? 'Publiée' : 'Brouillon' }}
        </span>
    </span>
{% endblock %}

{% block header_actions %}
    {% if not page.published %}
        <button type="button" data-copy="{{ page_path(page) }}?preview={{ page.previewToken }}"
                class="inline-flex items-center gap-1.5 rounded-none border border-ink/30 px-3.5 py-2 text-[13px] font-bold text-ink/75 transition hover:bg-ink/5"
                title="Lien de prévisualisation à partager avec le client (aucun compte requis)">
            {{ icons.icon('copy', 'h-4 w-4') }} Lien de prévisualisation
        </button>
    {% endif %}
    <a href="{{ page_path(page) }}{{ not page.published ? '?preview=' ~ page.previewToken }}" target="_blank"
       class="inline-flex items-center gap-1.5 rounded-none border border-ink/30 px-3.5 py-2 text-[13px] font-bold text-ink/75 transition hover:bg-ink/5">
        {{ icons.icon('eye', 'h-4 w-4') }} {{ page.published ? 'Voir la page' : 'Prévisualiser' }}
    </a>
{% endblock %}

{% block content %}
<div class="grid gap-8 xl:grid-cols-[1fr_340px]">

    {# ================= Colonne blocs ================= #}
    <div>
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-sm font-bold">Contenu de la page</h2>
            <p class="text-xs text-ink/45">Glissez-déposez la poignée pour réorganiser — l'ordre est enregistré automatiquement</p>
        </div>

        {% if page.blocks is empty %}
            <div class="rounded-none border-2 border-dashed border-ink/30 bg-paper px-6 py-14 text-center">
                <p class="text-sm font-semibold text-ink/55">Page vide</p>
                <p class="mt-1 text-sm text-ink/45">Ajoutez votre premier bloc depuis la palette à droite →</p>
            </div>
        {% endif %}

        <div id="blocks-list" class="space-y-4"
             data-reorder-url="{{ path('admin_page_reorder', {id: page.id}) }}"
             data-csrf="{{ csrf_token('admin') }}">

            {% for block in page.blocks %}
                <section id="bloc-{{ block.id }}" data-block-id="{{ block.id }}"
                         class="rounded-none border border-ink/15 bg-paper shadow-none {{ not block.enabled ? 'opacity-60' }}">

                    <header class="flex items-center gap-2 px-4 py-3">
                        <button type="button" data-drag-handle class="cursor-grab rounded-none p-1.5 text-ink/30 transition hover:bg-ink/10 hover:text-ink/55 active:cursor-grabbing" title="Déplacer">
                            {{ icons.icon('grip', 'h-5 w-5') }}
                        </button>
                        <div class="min-w-0">
                            <p class="text-sm font-bold">{{ block_label(block.type) }}</p>
                            <p class="truncate text-xs text-ink/45">{{ block.data.title|default(block.data.kicker|default('—')) }}</p>
                        </div>

                        <div class="ml-auto flex items-center gap-0.5">
                            {% if not block.enabled %}
                                <span class="mr-2 rounded-full bg-ink/15 px-2 py-0.5 text-[11px] font-bold text-ink/55">Masqué</span>
                            {% endif %}

                            <form method="post" action="{{ path('admin_block_toggle', {id: block.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:bg-ink/10 hover:text-ink/75" title="{{ block.enabled ? 'Masquer sur le site' : 'Afficher sur le site' }}">
                                    {{ icons.icon(block.enabled ? 'eye' : 'eye-off', 'h-4 w-4') }}
                                </button>
                            </form>

                            <form method="post" action="{{ path('admin_block_duplicate', {id: block.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:bg-ink/10 hover:text-ink/75" title="Dupliquer">
                                    {{ icons.icon('copy', 'h-4 w-4') }}
                                </button>
                            </form>

                            <form method="post" action="{{ path('admin_block_delete', {id: block.id}) }}" data-confirm="Supprimer ce bloc « {{ block_label(block.type) }} » ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button type="submit" class="rounded-none p-2 text-ink/45 transition hover:text-accent" title="Supprimer">
                                    {{ icons.icon('trash', 'h-4 w-4') }}
                                </button>
                            </form>

                            <button type="button" data-toggle="#form-bloc-{{ block.id }}"
                                    class="ml-1 inline-flex items-center gap-1 rounded-none border border-ink/15 px-3 py-1.5 text-xs font-bold text-ink/65 transition hover:border-accent hover:text-accent">
                                Modifier {{ icons.icon('chevron', 'h-3.5 w-3.5') }}
                            </button>
                        </div>
                    </header>

                    <div id="form-bloc-{{ block.id }}" class="hidden border-t border-ink/10 p-5">
                        {% set bf = block_forms[block.id] %}
                        {{ form_start(bf, {action: path('admin_block_save', {id: block.id}), method: 'POST'}) }}
                            {{ form_widget(bf) }}
                            <div class="mt-2 flex justify-end">
                                <button type="submit" class="rounded-none bg-ink px-4 py-2 text-[13px] font-bold text-paper transition hover:bg-accent">
                                    Enregistrer le bloc
                                </button>
                            </div>
                        {{ form_end(bf) }}
                    </div>
                </section>
            {% endfor %}
        </div>
    </div>

    {# ================= Colonne latérale ================= #}
    <aside class="space-y-6">

        {# Palette de blocs #}
        <div class="rounded-none border border-ink/15 bg-paper p-5">
            <h2 class="text-sm font-bold">Ajouter un bloc</h2>
            <div class="mt-4 space-y-2">
                {% for type in block_types %}
                    <form method="post" action="{{ path('admin_page_block_add', {id: page.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <input type="hidden" name="type" value="{{ type.key }}">
                        <button type="submit" class="group w-full rounded-none border border-ink/15 px-4 py-3 text-left transition hover:border-accent hover:bg-accent/40">
                            <span class="flex items-center justify-between text-[13px] font-bold text-ink/90 group-hover:text-accent">
                                {{ type.label }}
                                {{ icons.icon('plus', 'h-3.5 w-3.5 text-ink/30 group-hover:text-accent') }}
                            </span>
                            <span class="mt-0.5 block text-xs leading-snug text-ink/45">{{ type.description }}</span>
                        </button>
                    </form>
                {% endfor %}
            </div>
        </div>

        {# Traductions #}
        <div class="rounded-none border border-ink/15 bg-paper p-5">
            <h2 class="text-sm font-bold">Traductions</h2>
            <ul class="mt-3 space-y-2">
                {% for translation in translations %}
                    <li class="flex items-center justify-between rounded-none {{ translation.id == page.id ? 'bg-accent' : 'bg-ink/5' }} px-3 py-2">
                        <span class="flex items-center gap-2 text-[13px]">
                            <span class="rounded bg-paper px-1.5 py-0.5 text-[10px] font-bold uppercase text-ink/55 ring-1 ring-ink/15">{{ translation.locale }}</span>
                            {% if translation.id == page.id %}
                                <span class="font-bold text-accent">Cette page</span>
                            {% else %}
                                <a href="{{ path('admin_page_edit', {id: translation.id}) }}" class="font-semibold text-ink/75 hover:text-accent">{{ translation.title|length > 24 ? translation.title|slice(0, 24) ~ '…' : translation.title }}</a>
                            {% endif %}
                        </span>
                        <span class="px-2 py-0.5 text-[10px] font-bold {{ translation.published ? 'border border-ink text-ink' : 'border border-accent text-accent' }}">
                            {{ translation.published ? 'Publiée' : 'Brouillon' }}
                        </span>
                    </li>
                {% endfor %}
            </ul>
            {% set existing_locales = translations|map(t => t.locale) %}
            {% for locale in locales|filter(l => l not in existing_locales) %}
                <form method="post" action="{{ path('admin_page_translate', {id: page.id, locale: locale}) }}" class="mt-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                    <button type="submit" class="w-full rounded-none border border-dashed border-ink/30 px-3 py-2 text-xs font-semibold text-ink/55 transition hover:border-accent hover:text-accent">
                        + Créer la version {{ locale|upper }} (copie à traduire)
                    </button>
                </form>
            {% endfor %}
        </div>

        {# Réglages + SEO #}
        {{ form_start(settings_form) }}
            <div class="rounded-none border border-ink/15 bg-paper p-5">
                <h2 class="mb-4 text-sm font-bold">Réglages de la page</h2>
                {{ form_row(settings_form.title) }}
                {{ form_row(settings_form.slug) }}
                {{ form_row(settings_form.locale) }}
                {{ form_row(settings_form.status) }}
                {{ form_row(settings_form.isHomepage) }}
            </div>

            <div class="mt-6 rounded-none border border-ink/15 bg-paper p-5">
                <div class="mb-1 flex items-center justify-between">
                    <h2 class="text-sm font-bold">SEO</h2>
                    <span class="rounded-full px-2.5 py-0.5 text-[11px] font-bold
                        {{ seo_score >= 80 ? 'bg-ink text-paper' : (seo_score >= 50 ? 'border border-ink text-ink' : 'border border-accent text-accent') }}">
                        {{ seo_score }}/100
                    </span>
                </div>
                <p class="mb-3 text-xs text-ink/45">Sitemap, redirections 301 et Open Graph sont gérés automatiquement.</p>

                {# Checklist SEO #}
                <ul class="mb-5 space-y-1.5 rounded-none bg-ink/5 p-3">
                    {% for check in seo_checks %}
                        <li class="flex items-start gap-2 text-xs {{ check.ok ? 'text-ink/55' : 'font-medium text-accent' }}">
                            <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full {{ check.ok ? 'bg-accent' : 'bg-accent' }}"></span>
                            {{ check.label }}
                        </li>
                    {% endfor %}
                </ul>
                {{ form_row(settings_form.metaTitle) }}
                {{ form_row(settings_form.metaDescription) }}
                {{ form_row(settings_form.ogImage) }}
                {{ form_row(settings_form.canonicalUrl) }}
                {{ form_row(settings_form.noindex) }}
                {{ form_row(settings_form.structuredData) }}
            </div>

            <button type="submit" class="mt-4 w-full rounded-none bg-ink px-4 py-3 text-sm font-bold text-paper transition hover:bg-ink/75">
                Enregistrer les réglages
            </button>
        {{ form_end(settings_form) }}

        {# Historique des modifications #}
        {% if revisions|length > 0 %}
            <div class="rounded-none border border-ink/15 bg-paper p-5">
                <h2 class="text-sm font-bold">Historique</h2>
                <p class="mt-1 text-xs text-ink/45">États du contenu avant chaque modification — restaurez en un clic (20 derniers conservés).</p>
                <ul class="mt-3 space-y-1.5">
                    {% for revision in revisions %}
                        <li class="flex items-center justify-between gap-2 rounded-none bg-ink/5 px-3 py-2">
                            <span class="min-w-0">
                                <span class="block truncate text-xs font-semibold text-ink/65">{{ revision.label }}</span>
                                <span class="text-[11px] text-ink/45">{{ revision.createdAt|date('d/m/Y H:i') }} · {{ revision.snapshot|length }} bloc(s)</span>
                            </span>
                            <form method="post" action="{{ path('admin_page_revision_restore', {id: page.id, revisionId: revision.id}) }}"
                                  data-confirm="Restaurer le contenu tel qu'il était le {{ revision.createdAt|date('d/m/Y à H:i') }} ? L'état actuel sera lui-même sauvegardé dans l'historique.">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button type="submit" class="shrink-0 rounded-none border border-ink/15 px-2.5 py-1.5 text-[11px] font-bold text-ink/65 transition hover:border-accent hover:text-accent">
                                    Restaurer
                                </button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </aside>
</div>
{% endblock %}
