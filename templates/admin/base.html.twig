{% import 'admin/_icons.html.twig' as icons %}
{% import 'front/_trema.html.twig' as brand %}
<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Admin{% endblock %} — {{ setting('site_name', 'Starter CMS') }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lexend:wght@400;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block importmap %}{{ importmap('admin') }}{% endblock %}
</head>
<body class="h-full bg-canvas font-admin text-ink antialiased">
<div class="flex min-h-full">

    {# ---- Sidebar ---- #}
    <aside class="fixed inset-y-0 left-0 z-40 flex w-60 flex-col bg-ink text-paper/70">
        <div class="px-5 py-6">
            <p class="font-display text-lg font-black tracking-tight text-paper">
                {{ brand.trema(setting('site_name', 'Starter CMS')) }}
            </p>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-paper/40">Administration</p>
        </div>

        {% set route = app.request.attributes.get('_route') ?? '' %}
        {% macro navlink(path_name, label, icon_name, active, badge = 0) %}
            {% import 'admin/_icons.html.twig' as icons %}
{% import 'front/_trema.html.twig' as brand %}
            <a href="{{ path(path_name) }}"
               class="flex items-center gap-3 border-l-2 px-5 py-2.5 text-[13px] font-semibold transition
                      {{ active ? 'border-accent bg-paper/5 text-paper' : 'border-transparent text-paper/55 hover:bg-paper/5 hover:text-paper' }}">
                {{ icons.icon(icon_name, 'h-[18px] w-[18px] shrink-0') }} {{ label }}
                {% if badge > 0 %}
                    <span class="ml-auto rounded-full bg-accent px-2 py-0.5 text-[11px] font-bold text-paper">{{ badge }}</span>
                {% endif %}
            </a>
        {% endmacro %}

        <nav class="mt-2 flex-1 space-y-1">
            {{ _self.navlink('admin_dashboard', 'Tableau de bord', 'dashboard', route == 'admin_dashboard') }}
            {{ _self.navlink('admin_pages', 'Pages', 'pages', route starts with 'admin_page') }}
            {{ _self.navlink('admin_posts', 'Actualités', 'news', route starts with 'admin_post') }}
            {{ _self.navlink('admin_media', 'Médias', 'media', route starts with 'admin_media') }}
            {{ _self.navlink('admin_messages', 'Messages', 'mail', route starts with 'admin_message', unread_messages()) }}
            {{ _self.navlink('admin_navigation', 'Navigation', 'navigation', route starts with 'admin_navigation') }}
            {{ _self.navlink('admin_redirects', 'Redirections', 'redirects', route starts with 'admin_redirect') }}
            {{ _self.navlink('admin_settings', 'Réglages', 'settings', route starts with 'admin_settings') }}
        </nav>

        <div class="border-t border-paper/10 py-3">
            <a href="{{ path('front_homepage') }}" target="_blank" class="flex items-center gap-3 border-l-2 border-transparent px-5 py-2 text-[13px] font-semibold text-paper/55 transition hover:bg-paper/5 hover:text-paper">
                {{ icons.icon('external', 'h-[18px] w-[18px]') }} Voir le site
            </a>
            <a href="{{ path('admin_logout') }}" class="flex items-center gap-3 border-l-2 border-transparent px-5 py-2 text-[13px] font-semibold text-paper/55 transition hover:bg-paper/5 hover:text-paper">
                {{ icons.icon('logout', 'h-[18px] w-[18px]') }} Déconnexion
            </a>
        </div>
    </aside>

    {# ---- Contenu ---- #}
    <div class="ml-60 flex-1">
        <header class="sticky top-0 z-30 border-b border-ink/15 bg-paper/95 backdrop-blur">
            <div class="flex items-center justify-between px-8 py-4">
                <h1 class="font-display text-xl font-black tracking-tight">{% block page_title %}{% endblock %}</h1>
                <div class="flex items-center gap-3">{% block header_actions %}{% endblock %}</div>
            </div>
        </header>

        <main class="px-8 py-8">
            {% block content %}{% endblock %}
        </main>
    </div>
</div>

{# ---- Modale bibliothèque de médias (champs "Parcourir") ---- #}
<dialog id="mediaPicker" data-endpoint="{{ path('admin_media_picker') }}"
        class="m-auto w-full max-w-3xl rounded-none p-0 shadow-none backdrop:bg-ink/60">
    <div class="flex items-center justify-between border-b border-ink/10 px-5 py-4">
        <h2 class="text-sm font-bold">Choisir un média</h2>
        <div class="flex items-center gap-3">
            <a href="{{ path('admin_media') }}" target="_blank" class="text-xs font-semibold text-accent hover:underline">Importer de nouvelles images ↗</a>
            <button type="button" data-close class="rounded-none px-2.5 py-1 text-sm font-bold text-ink/45 hover:bg-ink/10 hover:text-ink/75">✕</button>
        </div>
    </div>
    <div id="mediaPickerGrid" class="grid max-h-[60vh] grid-cols-2 gap-3 overflow-y-auto p-5 sm:grid-cols-3 md:grid-cols-4"></div>
</dialog>

{# ---- Flashs ---- #}
<div class="fixed bottom-5 right-5 z-50 space-y-2" id="flashes">
    {% for message in app.flashes('success') %}
        <div data-flash class="flex items-center gap-2 rounded-none bg-ink px-4 py-3 text-sm font-medium text-paper shadow-none">
            {{ icons.icon('check', 'h-4 w-4 text-accent') }} {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div data-flash class="flex items-center gap-2 rounded-none bg-accent px-4 py-3 text-sm font-medium text-paper shadow-none">
            {{ message }}
        </div>
    {% endfor %}
</div>
</body>
</html>
