{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_page_new') }}" class="inline-flex items-center gap-1.5 rounded-none bg-ink px-3.5 py-2 text-[13px] font-bold text-paper transition hover:bg-accent">
        {{ icons.icon('plus', 'h-4 w-4') }} Nouvelle page
    </a>
{% endblock %}

{% block content %}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {% set cards = [
            {label: 'Pages', value: counts.pages, href: path('admin_pages'), icon: 'pages'},
            {label: 'Publiées', value: counts.published, href: path('admin_pages'), icon: 'check'},
            {label: 'Médias', value: counts.media, href: path('admin_media'), icon: 'media'},
            {label: 'Messages non lus', value: counts.unread_messages, href: path('admin_messages'), icon: 'mail'},
            {label: 'Redirections', value: counts.redirects, href: path('admin_redirects'), icon: 'redirects'},
        ] %}
        {% for card in cards %}
            <a href="{{ card.href }}" class="group rounded-none border border-ink/15 bg-paper p-5 transition hover:border-accent/40 hover:shadow-none">
                <div class="flex items-center justify-between">
                    <p class="text-[13px] font-semibold text-ink/55">{{ card.label }}</p>
                    <span class="text-ink/30 transition group-hover:text-accent">{{ icons.icon(card.icon, 'h-5 w-5') }}</span>
                </div>
                <p class="mt-2 text-3xl font-extrabold tracking-tight">{{ card.value }}</p>
            </a>
        {% endfor %}
    </div>

    <div class="mt-8 rounded-none border border-ink/15 bg-paper">
        <div class="border-b border-ink/10 px-5 py-4">
            <h2 class="text-sm font-bold">Dernières pages modifiées</h2>
        </div>
        {% if recent_pages is empty %}
            <p class="px-5 py-8 text-center text-sm text-ink/45">Aucune page pour le moment — créez-en une ou chargez les fixtures.</p>
        {% else %}
            <ul class="divide-y divide-ink/10">
                {% for page in recent_pages %}
                    <li>
                        <a href="{{ path('admin_page_edit', {id: page.id}) }}" class="flex items-center justify-between px-5 py-3.5 transition hover:bg-ink/5">
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-semibold">{{ page.title }}</span>
                                {% if page.isHomepage %}{{ icons.icon('home', 'h-3.5 w-3.5 text-ink/45') }}{% endif %}
                                <span class="px-2 py-0.5 text-[11px] font-bold {{ page.published ? 'border border-ink text-ink' : 'border border-accent text-accent' }}">
                                    {{ page.published ? 'Publiée' : 'Brouillon' }}
                                </span>
                            </div>
                            <span class="text-xs text-ink/45">{{ page.updatedAt|date('d/m/Y H:i') }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
