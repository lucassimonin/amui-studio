{% import 'front/_trema.html.twig' as brand %}
<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Connexion — {{ setting('site_name', 'Starter CMS') }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lexend:wght@400;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body class="flex h-full items-center justify-center bg-ink font-admin text-ink antialiased">
<div class="w-full max-w-sm px-6">
    <div class="mb-6 text-center">
        <h1 class="font-display text-4xl font-black tracking-tight text-paper">
            {{ brand.trema(setting('site_name', 'Starter CMS')) }}
        </h1>
        <p class="mt-2 font-mono text-[11px] uppercase tracking-wider text-paper/50">Espace d'administration</p>
    </div>

    <form method="post" class="rounded-none bg-paper p-6 shadow-none">
        {% if error %}
            <p class="mb-4 border border-accent px-3 py-2.5 text-sm font-medium text-accent">
                Identifiants incorrects, merci de réessayer.
            </p>
        {% endif %}

        <label for="username" class="mb-2 block font-mono text-[11px] uppercase tracking-wider text-ink/55"><span class="text-accent">01</span> Adresse e-mail</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus
               class="mb-4 block w-full rounded-none border border-ink/30 px-3 py-2.5 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/15">

        <label for="password" class="mb-2 block font-mono text-[11px] uppercase tracking-wider text-ink/55"><span class="text-accent">02</span> Mot de passe</label>
        <input type="password" name="_password" id="password" autocomplete="current-password" required
               class="mb-5 block w-full rounded-none border border-ink/30 px-3 py-2.5 text-sm outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/15">

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="w-full rounded-none bg-ink px-4 py-2.5 text-sm font-bold text-paper transition hover:bg-accent">
            Se connecter
        </button>
    </form>
</div>
</body>
</html>
