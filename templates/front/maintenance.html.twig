{% import 'front/_trema.html.twig' as brand %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Maintenance — {{ setting('site_name', 'Site en maintenance') }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lexend:wght@400;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body class="flex min-h-screen items-center justify-center bg-paper font-body text-ink antialiased">
<div class="mx-auto max-w-md px-6 text-center">
    {% if setting('logo_url') %}
        <img src="{{ setting('logo_url') }}" alt="{{ setting('site_name', '') }}" class="mx-auto h-16 w-auto">
    {% endif %}
    <p class="font-mono text-[11px] uppercase tracking-wider text-accent">Maintenance</p>
    <h1 class="mt-4 font-display text-4xl font-black leading-[1.02] tracking-tight sm:text-5xl">
        {{ brand.trema(setting('site_name', 'Notre site')) }} revient très vite<span class="text-accent">.</span>
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-ink/70">
        {{ setting('maintenance_text', 'Nous effectuons une petite mise à jour. Merci de votre patience, le site sera de retour dans quelques instants.') }}
    </p>
    {% if setting('phone') %}
        <p class="mt-6 text-sm text-ink/60">Besoin de nous joindre ? <a href="tel:{{ setting('phone')|replace({' ': ''}) }}" class="font-mono text-ink underline transition-colors hover:text-accent">{{ setting('phone') }}</a></p>
    {% endif %}
</div>
</body>
</html>
