{% extends 'front/base.html.twig' %}

{% set site_name = setting('site_name', 'Mon site') %}

{% block head_title %}Actualités — {{ site_name }}{% endblock %}

{% block seo %}
    <meta name="description" content="Les actualités de {{ site_name }} : nouveautés, projets et coulisses.">
    <link rel="canonical" href="{{ app.request.schemeAndHttpHost }}{{ path('front_blog') }}">
    <link rel="alternate" type="application/rss+xml" title="Actualités — {{ site_name }}" href="{{ path('front_blog_rss') }}">
{% endblock %}

{% block body %}
    <section class="border-b border-ink/15">
        <div class="mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pb-28 sm:pt-16">

            {% include 'front/_section_head.html.twig' with {index: 'Journal', title: 'Actualités', aside: posts is empty ? '' : '%02d'|format(posts|length)} only %}

            {# Filtres par catégorie #}
            {% if categories|length > 0 %}
                <div class="mt-8 flex flex-wrap gap-2">
                    <a href="{{ path(current_route) }}"
                       class="border px-4 py-2 font-mono text-[11px] uppercase tracking-wider transition {{ active_category is null ? 'border-ink bg-ink text-paper' : 'border-ink/20 text-ink/60 hover:border-accent hover:text-accent' }}">
                        Tout
                    </a>
                    {% for category in categories %}
                        <a href="{{ path(current_route, {categorie: category.slug}) }}"
                           class="border px-4 py-2 font-mono text-[11px] uppercase tracking-wider transition {{ active_category and active_category.id == category.id ? 'border-ink bg-ink text-paper' : 'border-ink/20 text-ink/60 hover:border-accent hover:text-accent' }}">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            {# Grille d'articles #}
            {% if posts is empty %}
                <p class="mt-16 font-mono text-[11px] uppercase tracking-wider text-ink/50">Aucun article pour le moment.</p>
            {% else %}
                <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
                    {% for post in posts %}
                        <article>
                            <a href="{{ post_path(post) }}" class="group block">
                                {% if post.coverImage %}
                                    <div class="aspect-[4/3] overflow-hidden bg-ink/5">
                                        <img src="{{ post.coverImage }}" alt="{{ post.coverAlt ?: post.title }}"
                                             class="h-full w-full object-cover" loading="lazy">
                                    </div>
                                {% endif %}

                                <div class="mt-4 flex items-baseline gap-4 border-t border-ink pt-3">
                                    <span class="font-mono text-[11px] text-ink/50 transition-colors duration-200 group-hover:text-accent">{{ '%02d'|format(loop.index) }}</span>
                                    <div class="min-w-0 flex-1">
                                        <h2 class="font-display text-xl font-black leading-tight tracking-tight sm:text-2xl">{{ post.title }}</h2>
                                        <div class="mt-1 font-mono text-[11px] uppercase tracking-wider text-ink/60">
                                            <time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date('d.m.Y') }}</time>
                                            {% if post.category %}
                                                <span class="mx-1.5 inline-block size-1.5 rounded-full bg-accent align-middle" aria-hidden="true"></span>{{ post.category.name }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {% if post.excerpt %}
                                    <p class="mt-3 text-sm leading-relaxed text-ink/70">{{ post.excerpt }}</p>
                                {% endif %}
                            </a>
                        </article>
                    {% endfor %}
                </div>

                {# Pagination #}
                {% if total_pages > 1 %}
                    <div class="mt-16 flex justify-center gap-2">
                        {% for p in 1..total_pages %}
                            <a href="{{ path(current_route, {page: p, categorie: active_category ? active_category.slug : null}) }}"
                               class="flex h-10 w-10 items-center justify-center border font-mono text-xs transition {{ p == current_page ? 'border-ink bg-ink text-paper' : 'border-ink/20 text-ink/60 hover:border-accent hover:text-accent' }}">
                                {{ '%02d'|format(p) }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </section>
{% endblock %}
