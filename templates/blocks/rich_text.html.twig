<section>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
        {% if data.kicker or data.title %}
            <div>
                {% if data.kicker %}
                    <p class="font-mono text-[11px] uppercase tracking-wider text-accent">{{ data.kicker }}</p>
                {% endif %}
                {% if data.title %}
                    <h2 class="mt-2 font-display text-4xl font-black leading-[0.95] tracking-tight sm:text-6xl">{{ data.title }}</h2>
                {% endif %}
            </div>
        {% endif %}
        <div class="prose-cms mt-8 text-sm text-ink/80 sm:text-base">
            {{ data.content|raw }}
        </div>
    </div>
</section>
