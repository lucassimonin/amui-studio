<section class="border-t border-ink/15">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
        {% if data.kicker or data.title %}
            <div>
                {% if data.kicker %}
                    <p class="text-xs font-semibold uppercase tracking-widest text-ink/70">{{ data.kicker }}</p>
                {% endif %}
                {% if data.title %}
                    <h2 class="mt-3 font-display text-3xl font-black tracking-tight sm:text-4xl">{{ data.title }}</h2>
                {% endif %}
            </div>
        {% endif %}
        <div class="prose-cms mt-8 text-sm text-ink/80 sm:text-base">
            {{ data.content|raw }}
        </div>
    </div>
</section>
