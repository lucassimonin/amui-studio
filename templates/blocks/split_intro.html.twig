<section {% if data.anchor|default('') %}id="{{ data.anchor }}"{% endif %} class="border-b border-ink/15">
    <div class="mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pb-28 sm:pt-16">

        {% if data.title %}
            {% include 'front/_section_head.html.twig' with {index: data.index|default(''), title: data.title, aside: data.subtitle|default('')} only %}
        {% endif %}

        {# Phrase forte : la ponctuation finale passe en accent, comme le tréma #}
        {% if data.statement %}
            {% set last = data.statement|slice(-1) %}
            <p class="mt-12 max-w-5xl font-display text-4xl font-black leading-[0.95] tracking-tight sm:text-6xl lg:text-7xl">
                {%- if last in ['.', '!', '?'] -%}
                    {{ data.statement|slice(0, -1) }}<span class="text-accent">{{ last }}</span>
                {%- else -%}
                    {{ data.statement }}
                {%- endif -%}
            </p>
        {% endif %}

        <div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-4">
            {% if data.text %}
                <p class="text-sm leading-relaxed text-ink/75">{{ data.text }}</p>
            {% endif %}

            {# Fiche technique : une ligne par domaine, compétences séparées par des points en accent #}
            {% set boxes = data.boxes|split_pairs %}
            {% if boxes|length > 0 %}
                <dl class="border-t border-ink lg:col-span-3">
                    {% for box in boxes %}
                        <div class="grid grid-cols-1 gap-2 border-b border-ink/10 py-5 sm:grid-cols-4 sm:gap-6">
                            <dt class="font-mono text-[11px] uppercase tracking-wider text-ink/50 sm:pt-2">
                                <span class="text-accent">{{ '%02d'|format(loop.index) }}</span> {{ box.left }}
                            </dt>
                            {# Le point reste collé à la compétence qui le précède : jamais de point en début de ligne #}
                            <dd class="font-display text-xl font-black leading-snug tracking-tight sm:col-span-3 sm:text-3xl">
                                {%- for item in box.right|split('·') -%}
                                    <span class="whitespace-nowrap">{{ item|trim }}
                                    {%- if not loop.last -%}
                                        <span class="ml-2.5 mr-1.5 inline-block size-1.5 rounded-full bg-accent align-middle sm:ml-3 sm:size-2" aria-hidden="true"></span><span class="sr-only">, </span>
                                    {%- endif -%}</span>{{ not loop.last ? ' ' }}
                                {%- endfor -%}
                            </dd>
                        </div>
                    {% endfor %}
                </dl>
            {% endif %}
        </div>
    </div>
</section>
