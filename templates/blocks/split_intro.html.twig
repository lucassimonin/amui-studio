<section {% if data.anchor|default('') %}id="{{ data.anchor }}"{% endif %} class="border-t border-ink/15">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
            <div class="lg:col-span-5">
                {% if data.title %}
                    <h2 class="font-display text-3xl font-black tracking-tight sm:text-4xl">{{ data.title }}</h2>
                {% endif %}
                {% if data.subtitle %}
                    <p class="mt-4 text-sm text-ink/70">{{ data.subtitle }}</p>
                {% endif %}
            </div>

            <div class="lg:col-span-7">
                {% if data.statement %}
                    <p class="font-display text-2xl font-black tracking-tight sm:text-3xl">{{ data.statement }}</p>
                {% endif %}
                {% if data.text %}
                    <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink/80">{{ data.text }}</p>
                {% endif %}

                {% set boxes = data.boxes|split_pairs %}
                {% if boxes|length > 0 %}
                    <dl class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
                        {% for box in boxes %}
                            <div class="border border-ink/15 p-5">
                                <dt class="text-xs font-semibold uppercase tracking-widest text-ink/70">{{ box.left }}</dt>
                                <dd class="mt-2 font-display text-lg font-black tracking-tight">{{ box.right }}</dd>
                            </div>
                        {% endfor %}
                    </dl>
                {% endif %}
            </div>
        </div>
    </div>
</section>
