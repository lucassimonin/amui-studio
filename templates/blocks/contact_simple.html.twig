<section {% if data.anchor|default('') %}id="{{ data.anchor }}"{% endif %}>
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-12 sm:px-6 sm:pb-16 sm:pt-16">

        {% if data.title %}
            {% include 'front/_section_head.html.twig' with {index: data.index|default(''), title: data.title} only %}
        {% endif %}

        {# ---- Email géant (le « @ » en accent) + téléphone ---- #}
        {% if data.email or data.phone %}
            <div class="mt-12">
                {% if data.infos_label %}
                    <div class="font-mono text-[11px] uppercase tracking-wider text-ink/50">{{ data.infos_label }}</div>
                {% endif %}
                {% if data.email %}
                    {% set parts = data.email|split('@', 2) %}
                    <a href="mailto:{{ data.email }}"
                       class="mt-3 block break-all font-display text-[clamp(2.25rem,8vw,6.5rem)] font-black leading-[0.95] tracking-tight transition-colors duration-200 hover:text-accent focus:text-accent sm:break-normal">
                        {{- parts[0] -}}
                        {%- if parts|length > 1 -%}<span class="text-accent">@</span>{{ parts[1] }}{%- endif -%}
                    </a>
                {% endif %}
                {% if data.phone %}
                    <a href="tel:{{ data.phone|replace({' ': ''}) }}"
                       class="mt-4 inline-block font-mono text-sm tracking-wider text-ink/70 transition-colors duration-200 hover:text-accent focus:text-accent">{{ data.phone }}</a>
                {% endif %}
            </div>
        {% endif %}

        <div class="mt-16 grid grid-cols-1 gap-10 border-t border-ink pt-8 lg:grid-cols-4">
            {% if data.text %}
                <p class="text-sm leading-relaxed text-ink/75">{{ data.text }}</p>
            {% endif %}

            {# ---- Formulaire ---- #}
            <form method="post" action="{{ path('front_contact') }}" class="lg:col-span-3" aria-label="Formulaire de contact">
                <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                <input type="hidden" name="block" value="{{ block.id }}">
                {# Honeypot anti-spam : invisible pour les humains #}
                <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">

                {% for message in app.flashes('contact_success') %}
                    <p class="mb-8 border border-ink bg-ink px-4 py-3 text-sm font-semibold text-paper" role="status">{{ message }}</p>
                {% endfor %}
                {% for message in app.flashes('contact_error') %}
                    <p class="mb-8 border border-accent px-4 py-3 text-sm font-semibold text-accent" role="alert">{{ message }}</p>
                {% endfor %}

                <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
                    <label class="block">
                        <span class="font-mono text-[11px] uppercase tracking-wider text-ink/50"><span class="text-accent">01</span> Nom</span>
                        <input required name="name" type="text" placeholder="Votre nom"
                               class="mt-2 w-full border-0 border-b border-ink/30 bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent">
                    </label>

                    <label class="block">
                        <span class="font-mono text-[11px] uppercase tracking-wider text-ink/50"><span class="text-accent">02</span> Email</span>
                        <input required name="email" type="email" placeholder="vous@exemple.com"
                               class="mt-2 w-full border-0 border-b border-ink/30 bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent">
                    </label>
                </div>

                <label class="mt-8 block">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-ink/50"><span class="text-accent">03</span> Sujet</span>
                    <input name="subject" type="text" placeholder="Site, identité, refonte…"
                           class="mt-2 w-full border-0 border-b border-ink/30 bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent">
                </label>

                <label class="mt-8 block">
                    <span class="font-mono text-[11px] uppercase tracking-wider text-ink/50"><span class="text-accent">04</span> Message</span>
                    <textarea required name="message" rows="4" minlength="10"
                              placeholder="Décrivez le contexte, l'objectif, et une contrainte clé."
                              class="mt-2 w-full resize-none border-0 border-b border-ink/30 bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent"></textarea>
                </label>

                <div class="mt-10 flex flex-wrap items-center justify-between gap-4">
                    {% if data.form_note %}
                        <p class="text-xs text-ink/60">{{ data.form_note }}</p>
                    {% endif %}
                    <button type="submit"
                            class="group inline-flex items-center gap-3 border border-ink bg-ink px-5 py-3 text-sm font-semibold text-paper transition-colors duration-200 hover:border-accent hover:bg-accent focus:border-accent focus:bg-accent">
                        Envoyer <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>
