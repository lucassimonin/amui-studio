<section {% if data.anchor|default('') %}id="{{ data.anchor }}"{% endif %} class="border-t border-ink/15">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">

            {# ---- Infos ---- #}
            <div class="lg:col-span-5">
                {% if data.title %}
                    <h2 class="font-display text-3xl font-black tracking-tight sm:text-4xl">{{ data.title }}</h2>
                {% endif %}
                {% if data.text %}
                    <p class="mt-4 text-sm leading-relaxed text-ink/70">{{ data.text }}</p>
                {% endif %}

                {% if data.email or data.phone %}
                    <div class="mt-8 border border-ink/15 p-5">
                        <div class="text-xs font-semibold uppercase tracking-widest text-ink/70">{{ data.infos_label ?: 'Infos' }}</div>
                        <div class="mt-3 space-y-2 text-sm">
                            {% if data.email %}
                                <a class="block transition-colors duration-200 hover:text-accent focus:text-accent" href="mailto:{{ data.email }}">{{ data.email }}</a>
                            {% endif %}
                            {% if data.phone %}
                                <a class="block transition-colors duration-200 hover:text-accent focus:text-accent" href="tel:{{ data.phone|replace({' ': ''}) }}">{{ data.phone }}</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {# ---- Formulaire ---- #}
            <div class="lg:col-span-7">
                <form method="post" action="{{ path('front_contact') }}" class="border border-ink p-6 sm:p-8" aria-label="Formulaire de contact">
                    <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                    <input type="hidden" name="block" value="{{ block.id }}">
                    {# Honeypot anti-spam : invisible pour les humains #}
                    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">

                    {% for message in app.flashes('contact_success') %}
                        <p class="mb-6 border border-ink bg-ink px-4 py-3 text-sm font-semibold text-paper" role="status">{{ message }}</p>
                    {% endfor %}
                    {% for message in app.flashes('contact_error') %}
                        <p class="mb-6 border border-accent px-4 py-3 text-sm font-semibold text-accent" role="alert">{{ message }}</p>
                    {% endfor %}

                    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
                        <label class="block">
                            <span class="text-xs font-semibold uppercase tracking-widest text-ink/70">Nom</span>
                            <input required name="name" type="text" placeholder="Votre nom"
                                   class="mt-3 w-full border-0 border-b border-ink bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent">
                        </label>

                        <label class="block">
                            <span class="text-xs font-semibold uppercase tracking-widest text-ink/70">Email</span>
                            <input required name="email" type="email" placeholder="vous@exemple.com"
                                   class="mt-3 w-full border-0 border-b border-ink bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent">
                        </label>
                    </div>

                    <label class="mt-8 block">
                        <span class="text-xs font-semibold uppercase tracking-widest text-ink/70">Sujet</span>
                        <input name="subject" type="text" placeholder="Site, identité, refonte…"
                               class="mt-3 w-full border-0 border-b border-ink bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent">
                    </label>

                    <label class="mt-8 block">
                        <span class="text-xs font-semibold uppercase tracking-widest text-ink/70">Message</span>
                        <textarea required name="message" rows="5" minlength="10"
                                  placeholder="Décrivez le contexte, l'objectif, et une contrainte clé."
                                  class="mt-3 w-full resize-none border-0 border-b border-ink bg-transparent px-0 py-3 font-body text-base outline-none transition-colors duration-200 placeholder:text-ink/35 focus:border-accent"></textarea>
                    </label>

                    <div class="mt-10 flex flex-wrap items-center justify-between gap-4">
                        {% if data.form_note %}
                            <p class="text-xs text-ink/60">{{ data.form_note }}</p>
                        {% endif %}
                        <button type="submit"
                                class="inline-flex items-center justify-center border border-ink bg-ink px-5 py-3 text-sm font-semibold text-paper transition-colors duration-200 hover:border-accent hover:bg-accent focus:border-accent focus:bg-accent">
                            Envoyer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
