# Environnement par défaut — surcharger dans .env.local (non versionné)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe_GenerateARandomSecretForProd
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Docker : docker compose up -d (MySQL 8 sur le port 3307, root/root)
DATABASE_URL="mysql://root:root@127.0.0.1:3307/cms_amui?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Emails du formulaire de contact (null = pas d'envoi en dev)
MAILER_DSN=null://null
###< symfony/mailer ###
